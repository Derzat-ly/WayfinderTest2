# All optional for local development. Copy to .env.local to override.

# SQLite file, relative to the project root.
DATABASE_URL=file:local.db

# Where the app is served. Defaults to http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# Signs session cookies. Required for `npm start` (production mode);
# `npm run dev` falls back to a development secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
